import WinrmRs.Code.Funs
import WinrmRs.Spec.Asn1Length
import WinrmRs.Properties.External
open Aeneas Aeneas.Std Result

/-!
# `encode_length` and `decode_length` of `src/asn1.rs`

The theorems are about the Lean translation of the two Rust functions
(`WinrmRs/Code/Funs.lean`, generated by Aeneas). A statement `f x ⦃ r => P r ⦄`
reads: `f x` returns, without a panic and without an arithmetic overflow, and
its result `r` satisfies `P`.

What is proved, for every input and not for the inputs of a test:

* `asn1.encode_length.total`: the encoder returns for every length, with one
  to five bytes;
* `asn1.encode_length.spec`: below 2^32, these bytes are the DER encoding;
* `asn1.decode_length.spec`: the decoder returns for every input, a hostile
  one included, and computes `Spec.decodeLength`;
* `asn1.decode_length.bounded`: a length it accepts is below 2^24, and it
  consumed one to four bytes of the input, no more;
* `asn1.decode_encode`: below 2^24, decoding what was encoded gives the
  length back and leaves the bytes after it untouched;
* `asn1.decode_encode_refused`: from 2^24 up, the decoder refuses what the
  encoder wrote, which is the asymmetry the Rust comments describe.
-/

namespace WinrmRs

/-! ## The encoder -/

/-- **Spec theorem for `winrm_rs::asn1::encode_length`**
The encoder returns for every length, and writes one to five bytes. -/
theorem asn1.encode_length.total (len : Std.Usize) :
    asn1.encode_length len ⦃ (v : alloc.vec.Vec Std.U8) =>
      1 ≤ v.val.length ∧ v.val.length ≤ 5 ⦄ := by
  unfold asn1.encode_length
  step*
  all_goals
    simp_all [alloc.slice.Slice.into_vec, alloc.vec.Vec.val, Array.to_slice]

/-- **Spec theorem for `winrm_rs::asn1::encode_length`**
Below 2^32 the bytes written are the DER encoding of the length.

The bound is needed: the form on five bytes carries four bytes of length, so
on a 64-bit target a length of 2^32 or more would lose its high bits. -/
theorem asn1.encode_length.spec (len : Std.Usize) (h : len.val < 2 ^ 32) :
    asn1.encode_length len ⦃ (v : alloc.vec.Vec Std.U8) =>
      v.val.map (·.val) = Spec.derLength len.val ⦄ := by
  unfold asn1.encode_length
  step*
  all_goals
    simp_all [Spec.derLength, alloc.slice.Slice.into_vec, alloc.vec.Vec.val, Array.to_slice]
    grind

/-! ## The fold of `decode_length`

`len_bytes.iter().fold(0usize, |len, &b| (len << 8) | usize::from(b))` -/

/-- **Spec theorem for the closure of `winrm_rs::asn1::decode_length`**
`(len << 8) | b` is `len * 256 + b` as long as `len` is below 2^16: the shift
then loses no bit, on a `usize` of 32 bits as on one of 64. -/
theorem asn1.decode_length.closure.call_mut.spec
    (c : asn1.decode_length.closure) (acc : Std.Usize) (b : Std.U8)
    (h : acc.val < 2 ^ 16) :
    asn1.decode_length.closure.Insts.CoreOpsFunctionFnMutPairUsizeShared0U8Usize.call_mut
      c (acc, b)
      ⦃ (r : Std.Usize) (_ : asn1.decode_length.closure) =>
        r.val = acc.val * 256 + b.val ⦄ := by
  unfold asn1.decode_length.closure.Insts.CoreOpsFunctionFnMutPairUsizeShared0U8Usize.call_mut
  simp only [step_simps]
  let* ⟨ i, i_post, i_post1 ⟩ ← Usize.ShiftLeft_IScalar_spec
  · cases System.Platform.numBits_eq <;> simp [*]
  simp [lift]
  have hsz : acc.val <<< 8 < Usize.size := by
    rw [Nat.shiftLeft_eq]; scalar_tac
  have hb : b.val < 2 ^ 8 := by scalar_tac
  rw [i_post, Nat.mod_eq_of_lt hsz, ← Nat.shiftLeft_add_eq_or_of_lt hb, Nat.shiftLeft_eq]

/-- The fold over at most three bytes, from an `acc` that leaves room for
them, spells the number these bytes write after `acc`. -/
theorem Model.foldList.spec_be (l : List Std.U8) (acc : Std.Usize)
    (c : asn1.decode_length.closure)
    (hl : l.length ≤ 3) (hacc : acc.val < 256 ^ (3 - l.length)) :
    Model.foldList
      asn1.decode_length.closure.Insts.CoreOpsFunctionFnMutPairUsizeShared0U8Usize l acc c
      ⦃ (r : Std.Usize) => r.val = Spec.beValueFrom acc.val (l.map (·.val)) ⦄ := by
  induction l generalizing acc c with
  | nil => simp [Model.foldList, Spec.beValueFrom]
  | cons x xs ih =>
    simp only [Model.foldList]
    have hn : xs.length = 0 ∨ xs.length = 1 ∨ xs.length = 2 := by
      simp only [List.length_cons] at hl; omega
    have h16 : acc.val < 2 ^ 16 := by
      rcases hn with hn | hn | hn <;> simp [hn] at hacc <;> omega
    apply WP.spec_bind (asn1.decode_length.closure.call_mut.spec c acc x h16)
    intro r hr
    obtain ⟨r, c'⟩ := r
    have hr' : r.val = acc.val * 256 + x.val := by simpa using hr
    have hx : x.val < 256 := by scalar_tac
    have hlen : xs.length ≤ 3 := by omega
    have hacc' : r.val < 256 ^ (3 - xs.length) := by
      rcases hn with hn | hn | hn <;> simp [hn] at hacc ⊢ <;> omega
    have := ih r c' hlen hacc'
    simpa [Spec.beValueFrom, hr'] using this

/-- **Spec theorem for `Iterator::fold` on the length bytes** -/
@[step]
theorem asn1.decode_length.fold.spec (it : core.slice.iter.Iter Std.U8) (hi : it.i = 0)
    (hl : it.slice.val.length ≤ 3) :
    core.slice.iter.Iter.Insts.CoreIterTraitsIteratorIteratorSharedAT.fold
      asn1.decode_length.closure.Insts.CoreOpsFunctionFnMutPairUsizeShared0U8Usize
      it 0#usize ()
      ⦃ (n : Std.Usize) => n.val = Spec.beValueFrom 0 (it.slice.val.map (·.val)) ⦄ := by
  unfold core.slice.iter.Iter.Insts.CoreIterTraitsIteratorIteratorSharedAT.fold
  have := Model.foldList.spec_be (it.slice.val.drop it.i) 0#usize ()
    (by simpa [hi] using hl) (by simp)
  simpa [hi] using this

/-! ## The decoder -/

theorem and_127 (x : Nat) : x &&& 127 = x % 128 := by
  simpa using Nat.and_two_pow_sub_one_eq_mod x 7

/-- **Spec theorem for `winrm_rs::asn1::decode_length`**
The decoder returns for every input, and computes `Spec.decodeLength`: it
accepts the fields that one accepts, with the same length and the same bytes
left after the field, and it refuses the others. -/
theorem asn1.decode_length.spec (data : Slice Std.U8) :
    asn1.decode_length data
      ⦃ (r : core.result.Result (Std.Usize × Slice Std.U8) error.CredSspError) =>
        match r with
        | .Ok (n, rest) =>
          Spec.decodeLength (data.val.map (·.val)) = some (n.val, rest.val.map (·.val))
        | .Err _ => Spec.decodeLength (data.val.map (·.val)) = none ⦄ := by
  unfold asn1.decode_length
  simp only [step_simps]
  let* ⟨ o, o_post ⟩ ← split_first.spec
  spec_split
  · let* ⟨ s ⟩ ← string_from.spec
    simp_all [Spec.decodeLength]
  · rename_i p _
    obtain ⟨first, rest⟩ := p
    simp only [lift]
    have hk : (core.convert.num.FromUsizeU8.from (first &&& 127#u8)).val = first.val % 128 := by
      simp [and_127]
    simp only [step_simps]
    spec_split
    · simp only [step_simps]
      simp_all [Spec.decodeLength]
    · let* ⟨ o1, o1_post ⟩ ← split_at_checked.spec
      spec_split
      · spec_split
        · spec_split
          · let* ⟨ s ⟩ ← string_from.spec
            simp_all [Spec.decodeLength]
            grind
          · rename_i p1 _
            obtain ⟨len_bytes, after⟩ := p1
            simp only [core.slice.Slice.iter]
            let* ⟨ len, len_post ⟩ ← asn1.decode_length.fold.spec
            · simp_all
            simp_all [Spec.decodeLength]
        · let* ⟨ s ⟩ ← string_from.spec
          simp_all [Spec.decodeLength]
          grind
      · let* ⟨ s ⟩ ← string_from.spec
        simp_all [Spec.decodeLength]

/-! ## On the specification alone -/

/-- Below 2^24, reading the DER encoding of a length gives the length back,
and the bytes that followed it. -/
theorem Spec.decode_der (n : Nat) (rest : List Nat) (h : n < 2 ^ 24) :
    Spec.decodeLength (Spec.derLength n ++ rest) = some (n, rest) := by
  unfold Spec.derLength
  split_ifs <;> simp [Spec.decodeLength, Spec.beValueFrom] <;> omega

/-- From 2^24 up, the DER encoding of a length is refused. -/
theorem Spec.decode_der_refused (n : Nat) (rest : List Nat) (h : 2 ^ 24 ≤ n) :
    Spec.decodeLength (Spec.derLength n ++ rest) = none := by
  unfold Spec.derLength
  split_ifs <;> simp [Spec.decodeLength] <;> omega

theorem Spec.beValueFrom_lt (bytes : List Nat) (hb : ∀ b ∈ bytes, b < 256) (acc m : Nat)
    (hacc : acc < 256 ^ m) :
    Spec.beValueFrom acc bytes < 256 ^ (m + bytes.length) := by
  induction bytes generalizing acc m with
  | nil => simpa [Spec.beValueFrom] using hacc
  | cons b bs ih =>
    have hb0 : b < 256 := hb b (by simp)
    have hstep : acc * 256 + b < 256 ^ (m + 1) := by
      rw [Nat.pow_succ]; omega
    have := ih (fun x hx => hb x (by simp [hx])) (acc * 256 + b) (m + 1) hstep
    simpa [Spec.beValueFrom, Nat.add_assoc, Nat.add_comm 1] using this

/-- A field that is read took one to four elements off the front of the
input, and its length is below 2^24 when the elements are bytes. -/
theorem Spec.decodeLength_consumed (l : List Nat) (n : Nat) (rest : List Nat)
    (h : Spec.decodeLength l = some (n, rest)) :
    ∃ k, 1 ≤ k ∧ k ≤ 4 ∧ k ≤ l.length ∧ rest = l.drop k ∧
      ((∀ b ∈ l, b < 256) → n < 2 ^ 24) := by
  cases l with
  | nil => simp [Spec.decodeLength] at h
  | cons first tl =>
    simp only [Spec.decodeLength] at h
    split at h
    · simp only [Option.some.injEq, Prod.mk.injEq] at h
      obtain ⟨rfl, rfl⟩ := h
      exact ⟨1, by simp, by simp, by simp, by simp, fun _ => by omega⟩
    · split at h
      · rename_i hk
        simp only [Option.some.injEq, Prod.mk.injEq] at h
        obtain ⟨rfl, rfl⟩ := h
        refine ⟨first % 128 + 1, by omega, by omega, by simp; omega, by simp, ?_⟩
        intro hb
        have hlt := Spec.beValueFrom_lt (tl.take (first % 128))
          (fun b hb' => hb b (by simp [List.mem_of_mem_take hb'])) 0 0 (by simp)
        have hlen : (tl.take (first % 128)).length ≤ 3 := by simp; omega
        calc Spec.beValueFrom 0 (tl.take (first % 128))
            < 256 ^ (0 + (tl.take (first % 128)).length) := hlt
          _ ≤ 256 ^ 3 := Nat.pow_le_pow_right (by decide) (by omega)
          _ = 2 ^ 24 := by norm_num
      · simp at h

/-! ## The two functions together -/

theorem map_val_injective (l1 l2 : List Std.U8)
    (h : l1.map (·.val) = l2.map (·.val)) : l1 = l2 := by
  induction l1 generalizing l2 with
  | nil => cases l2 <;> simp_all
  | cons x xs ih =>
    cases l2 with
    | nil => simp at h
    | cons y ys =>
      simp only [List.map_cons, List.cons.injEq] at h
      rw [UScalar.eq_of_val_eq h.1, ih ys h.2]

/-- **A length the decoder accepts is bounded, and so is what it consumed.**
Whatever bytes a server sends, `decode_length` returns; when it accepts the
field, the length is below 2^24 and the bytes it gives back are the input
minus its first one to four bytes. -/
theorem asn1.decode_length.bounded (data : Slice Std.U8) :
    asn1.decode_length data
      ⦃ (r : core.result.Result (Std.Usize × Slice Std.U8) error.CredSspError) =>
        match r with
        | .Ok (n, rest) =>
          n.val < 2 ^ 24 ∧
          ∃ k, 1 ≤ k ∧ k ≤ 4 ∧ k ≤ data.val.length ∧ rest.val = data.val.drop k
        | .Err _ => True ⦄ := by
  apply WP.spec_mono (asn1.decode_length.spec data)
  intro r hr
  match r, hr with
  | .Ok (n, rest), hr =>
    obtain ⟨k, hk1, hk4, hkl, hrest, hn⟩ := Spec.decodeLength_consumed _ _ _ hr
    refine ⟨hn ?_, k, hk1, hk4, by simpa using hkl, ?_⟩
    · intro b hb
      obtain ⟨x, _, rfl⟩ := List.mem_map.mp hb
      scalar_tac
    · apply map_val_injective
      rw [hrest, List.map_drop]
  | .Err _, _ => trivial

/-- **Decoding what was encoded gives the length back.**
For a length below 2^24: if `data` is the bytes `encode_length` wrote followed
by `rest`, then `decode_length data` is `Ok((len, rest))`. -/
theorem asn1.decode_encode (len : Std.Usize) (h : len.val < 2 ^ 24) :
    asn1.encode_length len ⦃ (v : alloc.vec.Vec Std.U8) =>
      ∀ (data rest : Slice Std.U8), data.val = v.val ++ rest.val →
        asn1.decode_length data ⦃ r => r = .Ok (len, rest) ⦄ ⦄ := by
  apply WP.spec_mono (asn1.encode_length.spec len (by omega))
  intro v hv data rest hdata
  apply WP.spec_mono (asn1.decode_length.spec data)
  intro r hr
  have hd : data.val.map (·.val) = Spec.derLength len.val ++ rest.val.map (·.val) := by
    simp [hdata, hv]
  rw [hd, Spec.decode_der _ _ h] at hr
  match r, hr with
  | .Ok (n, rest'), hr =>
    simp only [Option.some.injEq, Prod.mk.injEq] at hr
    have h1 : n = len := UScalar.eq_of_val_eq hr.1.symm
    have h2 : rest' = rest := Slice.ext _ _ (map_val_injective _ _ hr.2.symm)
    rw [h1, h2]
  | .Err _, hr => simp at hr

/-- **From 2^24 up, the decoder refuses what the encoder wrote.**
The encoder then writes the form on five bytes, so that it never declares a
wrong length, and the decoder stops at four: a server cannot make it accept a
length of 16 MiB or more. -/
theorem asn1.decode_encode_refused (len : Std.Usize)
    (h : 2 ^ 24 ≤ len.val) (h32 : len.val < 2 ^ 32) :
    asn1.encode_length len ⦃ (v : alloc.vec.Vec Std.U8) =>
      ∀ (data rest : Slice Std.U8), data.val = v.val ++ rest.val →
        asn1.decode_length data ⦃ r => ∃ e, r = .Err e ⦄ ⦄ := by
  apply WP.spec_mono (asn1.encode_length.spec len h32)
  intro v hv data rest hdata
  apply WP.spec_mono (asn1.decode_length.spec data)
  intro r hr
  have hd : data.val.map (·.val) = Spec.derLength len.val ++ rest.val.map (·.val) := by
    simp [hdata, hv]
  rw [hd, Spec.decode_der_refused _ _ h] at hr
  match r, hr with
  | .Ok (n, rest'), hr => simp at hr
  | .Err e, _ => exact ⟨e, rfl⟩

end WinrmRs
